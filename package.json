{
  "name": "point-scan-solve",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "web:https": "node scripts/serve-https.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:workers": "node scripts/build-workers.mjs",
    "build:vision": "python scripts/build-vision.py",
    "build:web": "node scripts/check-vision.mjs && npm run build:workers && expo export --platform web",
    "eas-build-post-install": "node scripts/eas-post-install.mjs",
    "native:generate": "cd modules/cube-vision && nitrogen",
    "native:prepare": "python scripts/prepare-native.py",
    "test:vision": "node scripts/test-vision.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@point-scan-solve/cube-vision": "file:modules/cube-vision",
    "babel-preset-expo": "~57.0.14",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "esbuild": "^0.25.0",
    "nitrogen": "0.37.1",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
